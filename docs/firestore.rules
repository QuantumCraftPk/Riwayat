rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only this signed-in account counts as the administrator.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ilmfajrpakistan@gmail.com';
    }

    // Staff accounts: emails listed (by the admin) in the document config/staff, field "emails".
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in get(/databases/$(database)/documents/config/staff).data.emails;
    }

    // Staff may only change the status field (and its time stamp), and only to a known value.
    function staffStatusOnly(allowed) {
      return isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt'])
        && request.resource.data.status in allowed
        && (!('statusAt' in request.resource.data) || request.resource.data.statusAt is string);
    }

    // A new order or reservation sent by a customer: fixed fields, status must start as "new".
    function validNew(kind) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'kind', 'status', 'placedAt', 'total', 'name', 'phone', 'type', 'json'])
        && d.keys().hasAll(['id', 'kind', 'status', 'placedAt', 'total', 'name', 'phone', 'type', 'json'])
        && d.kind == kind
        && d.status == 'new'
        && d.id is string && d.id.size() < 40
        && d.placedAt is string && d.placedAt.size() < 40
        && d.total is number
        && d.name is string && d.name.size() < 100
        && d.phone is string && d.phone.size() < 40
        && d.type is string && d.type.size() < 20
        && d.json is string && d.json.size() < 30000;
    }

    // Website content (menu, celebrations, settings): anyone can read, only the admin can change.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: a customer can place one and read ONLY their own (the long random document id is the key).
    match /orders/{id} {
      allow get: if true;
      allow list: if isAdmin() || isStaff();
      allow update: if isAdmin() || staffStatusOnly(['new', 'accepted', 'preparing', 'ready', 'completed', 'cancelled']);
      allow delete: if isAdmin();
      allow create: if validNew('order');
    }

    match /reservations/{id} {
      allow get: if true;
      allow list: if isAdmin() || isStaff();
      allow update: if isAdmin() || staffStatusOnly(['new', 'confirmed', 'declined']);
      allow delete: if isAdmin();
      allow create: if validNew('reservation');
    }

    // Staff list: only the admin can read or change it.
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
